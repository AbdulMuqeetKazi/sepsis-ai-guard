# SepsisAI Guard — Environment Variables
# Copy to .env and fill in values as needed

# Application
DEBUG=false
APP_NAME=SepsisAI Guard API
APP_VERSION=1.0.0

# CORS (comma-separated frontend URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Supabase (optional — API runs without these; enables persistence)
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_KEY=

# ML thresholds
ALERT_PROBABILITY_THRESHOLD=0.61
PREDICTION_THRESHOLD=0.5

# Gemini clinical assistant (optional — explanations, summaries, chat only)
# Get a key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=
ENABLE_GEMINI_AGENT=false
GEMINI_MODEL=gemini-2.5-flash
